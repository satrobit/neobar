    "Some items can’t be accessed. Allow NeoBar to access their folder in your Mac’s privacy settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einige Objekte kann nicht zugegriffen werden. Erlaube NeoBar in den Datenschutzeinstellungen deines Macs den Zugriff auf den betreffenden Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some items can’t be accessed. Allow NeoBar to access their folder in your Mac’s privacy settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder a algunos ítems. Permite que NeoBar acceda a su carpeta en los ajustes de privacidad de tu Mac."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder a algunos elementos. Permite que NeoBar acceda a su carpeta en la configuración de privacidad de tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains éléments sont inaccessibles. Autorisez NeoBar à accéder à leur dossier dans les réglages de confidentialité de votre Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ आइटम ऐक्सेस नहीं किए जा सकते। अपने Mac की गोपनीयता सेटिंग में NeoBar को उनके फ़ोल्डर का ऐक्सेस दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni elementi non sono accessibili. Consenti a NeoBar di accedere alla loro cartella nelle impostazioni della privacy del Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の項目にアクセスできません。Macのプライバシー設定で、それらの項目があるフォルダへのNeoBarのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 항목에 접근할 수 없습니다. Mac의 개인정보 보호 설정에서 NeoBar가 해당 폴더에 접근하도록 허용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar alguns itens. Permita que o NeoBar acesse a pasta deles nos ajustes de privacidade do seu Mac."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível aceder a alguns elementos. Permita que o NeoBar aceda à pasta destes nas definições de privacidade do seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "К некоторым объектам нет доступа. Разрешите NeoBar доступ к их папке в настройках конфиденциальности Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı öğelere erişilemiyor. Mac’inizin gizlilik ayarlarında NeoBar’in bu öğelerin klasörüne erişmesine izin verin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể truy cập một số mục. Hãy cho phép NeoBar truy cập thư mục chứa chúng trong cài đặt quyền riêng tư của máy Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有项目暂时无法访问。请在系统隐私设置里允许NeoBar访问它们所在的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些項目無法取用。請在Mac的隱私權設定裡允許NeoBar取用它們所在的檔案夾。"
          }
        }
      }
    },
