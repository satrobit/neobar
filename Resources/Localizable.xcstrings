    "%@ is already taken by another app. The previous shortcut stays active." : {
      "comment" : "设置窗口 · 改键失败弹窗",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird bereits von einer anderen App verwendet. Der bisherige Kurzbefehl bleibt aktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is already taken by another app. The previous shortcut stays active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya está en uso por otra app. El atajo anterior sigue activo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya está en uso por otra app. El atajo anterior sigue activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est déjà utilisé par une autre app. Le raccourci précédent reste actif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शॉर्टकट %@ पहले से किसी दूसरे ऐप के पास है। पिछला शॉर्टकट चालू रहेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già in uso in un’altra app. Resta attiva la scorciatoia precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はほかのアプリが使用しています。以前のショートカットをそのまま使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 다른 앱에서 이미 사용 중입니다. 이전 단축키는 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já está em uso por outro app. O atalho anterior continua ativo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já está a ser utilizado por outra aplicação. O atalho anterior continua ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетание %@ уже используется другим приложением. Прежнее сочетание остается в силе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ başka bir uygulama tarafından zaten kullanılıyor. Önceki kestirme etkin kalacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
