    "Are you sure you want to permanently erase the items in the Trash?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du die Objekte im Papierkorb wirklich endgültig löschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to permanently erase the items in the Trash?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que quieres borrar definitivamente los ítems de la papelera?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres borrar permanentemente los elementos del basurero?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment effacer définitivement les éléments de la corbeille ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप निश्चित हैं कि आप रद्दी के आइटम स्थायी रूप से मिटाना चाहते हैं?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confermi di voler cancellare definitivamente gli elementi contenuti nel Cestino?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱にある項目を完全に消去してもよろしいですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴지통에 있는 항목들을 영구적으로 지우겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja apagar os itens do Lixo definitivamente?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem a certeza de que pretende eliminar de vez os elementos apagados que se encontram no Lixo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы действительно хотите навсегда стереть все объекты в Корзине?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çöp Sepeti’ndeki öğeleri tamamen silmek istediğinizden emin misiniz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có chắc chắn muốn xóa vĩnh viễn các mục trong Thùng rác không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
