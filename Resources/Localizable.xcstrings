          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите NeoBar здесь: %@. Окно закроется само, и панель задач завершит запуск."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu konumda NeoBar’in anahtarını açın: %@. Bunu yaptığınızda bu pencere kendiliğinden kapanır ve görev çubuğunun başlatılması tamamlanır."
          }
        },
        "vi" : {
          "stringUnit" : {
